model Booking {
  id                 String               @id @default(uuid())
  customerId         String
  customer           User                 @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  technicianProfileId String
  technicianProfile   TechnicianProfile  @relation("TechnicianBookings", fields: [technicianProfileId], references: [id], onDelete: Cascade)

  serviceId          String
  service            Service              @relation(fields: [serviceId], references: [id])
  bookingDetails     String
  location           String
  bookingDate        DateTime
  status             BookingStatus        @default(REQUESTED)
  payments           Payment[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

}
